# copy to .env and fill in. docker compose loads this file for the backend.

# --- Azure Speech resource (required) ---
AZURE_SPEECH_KEY=
# use the endpoint (recommended for new resources) ...
AZURE_SPEECH_ENDPOINT=
# ... or the region name (e.g. westus, eastus), used when the endpoint is empty.
AZURE_SPEECH_REGION=

# --- text to speech (model pronunciation) ---
# Azure voices are offered whenever the Speech credentials above are set.
# set to false to hide them without affecting the assessment feature.
TTS_AZURE_ENABLED=true

# let users type a voice id that the provider does not list (a private or
# preview voice on your account). off by default: it lets a caller name any
# voice the upstream key can reach.
TTS_ALLOW_CUSTOM_VOICES=false

# extra voice providers. each appears in the UI only when its key is
# non-empty, so leaving these blank simply hides them.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- translator (write in your own language, practice in another) ---
# leave TRANSLATOR_MODEL empty to hide the feature entirely.
TRANSLATOR_ENABLED=true

# "openai" speaks the chat-completions dialect, which covers OpenAI, Gemini's
# compatibility endpoint, OpenRouter, vLLM, LM Studio and Ollama.
# "anthropic" speaks Claude's Messages API.
TRANSLATOR_PROVIDER=openai

#   OpenAI     https://api.openai.com/v1              + key, e.g. gpt-4o-mini
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai
#                                                     + key, e.g. gemini-2.5-flash
#   Ollama     http://host.docker.internal:11434/v1   no key, e.g. llama3.1
#   Anthropic  https://api.anthropic.com/v1           + key, e.g. claude-sonnet-5
TRANSLATOR_BASE_URL=https://api.openai.com/v1
TRANSLATOR_API_KEY=
TRANSLATOR_MODEL=

# <selected-language> becomes the language being practiced, e.g.
# "Russian (Russia)". <selected-locale> becomes the code, e.g. "ru-RU".
TRANSLATOR_PROMPT=Translate the following text into <selected-language>. Keep the tone, and output only the translation without any extra notes

# let users rewrite the prompt in the UI. off by default: the fixed prompt is
# what keeps this endpoint a translator rather than an open LLM proxy.
TRANSLATOR_PROMPT_EDITABLE=false

TRANSLATOR_TEMPERATURE=0.2
TRANSLATOR_MAX_TOKENS=2048
TRANSLATOR_TIMEOUT=60
TRANSLATOR_MAX_CHARS=5000

# --- CORS ---
# comma-separated allowed origins for the API. leave empty when the frontend
# nginx proxies /api and /ws under the same origin (the default deployment).
# set it when the browser talks to the backend on a different origin, e.g.:
# CORS_ORIGINS=http://localhost:4200,https://cadence.example.com
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# --- spending guard ---
# ceiling on estimated upstream spend per UTC day, across the assessment,
# every TTS provider and the translator. requests that would cross it are
# refused with 429 until midnight UTC, which caps the damage from a stuck
# client or a leaked password and leaves you time to notice. 0 disables it.
DAILY_BUDGET_USD=10.0

# the rates the estimate is built from. these approximate list pricing, so
# check them against what you are actually billed, since it varies by region,
# tier and over time. raising a rate makes the guard more cautious.
COST_ASSESSMENT_PER_AUDIO_HOUR=1.00
COST_TTS_AZURE_PER_MILLION_CHARS=15.00
COST_TTS_OPENAI_PER_MILLION_CHARS=15.00
COST_TTS_GEMINI_PER_MILLION_CHARS=15.00
COST_TTS_ELEVENLABS_PER_MILLION_CHARS=220.00
COST_TRANSLATION_PER_MILLION_CHARS=2.00

# burst protection at nginx, per client address, on /api. the budget bounds
# the total; this stops anyone hammering it in the meantime.
API_RATE_LIMIT=10
API_RATE_BURST=20

# --- hiding the app behind a path ---
# serve the app and the API from secret prefixes. they are independent, and
# anything outside them answers 404 with an empty body, so "/" gives no hint
# that this is here. both default to "/" (classic layout).
#   FRONTEND_PATH=/project-2022-72245
#   API_PATH=/b8f31c9a
# this is obfuscation, not access control: it keeps crawlers and casual scans
# away, but anyone who learns the path gets in. put auth in front for real
# protection.
FRONTEND_PATH=/
API_PATH=/

# serve the OpenAPI schema and Swagger UI at <API_PATH>/api/docs. off by
# default: the schema lists every endpoint, undoing the hiding above.
API_DOCS_ENABLED=false

# --- deployment ---
# host port where the frontend (nginx) is published in docker-compose.yml
CADENCE_PORT=8080
# interface to publish it on. set to 127.0.0.1 whenever a reverse proxy on
# this host fronts the app: otherwise the port stays reachable from the
# network and anyone can skip the proxy (and its login) entirely.
# note that Docker publishes ports with its own iptables rules, which UFW
# does not filter, so a "ufw deny 8080" will NOT close it. binding to
# loopback is the reliable fix.
CADENCE_BIND=0.0.0.0

# --- docker network ---
# by default compose creates its own network. to join one that already exists,
# such as the network your reverse proxy runs on, name it here and set the
# external flag. your proxy can then reach cadence-frontend:80 and
# cadence-authelia:9091 by name, with no published ports at all.
#   CADENCE_NETWORK=caddy_net
#   CADENCE_NETWORK_EXTERNAL=true
CADENCE_NETWORK=cadence_default
CADENCE_NETWORK_EXTERNAL=false

# --- optional Caddy + Authelia overlay (docker-compose.caddy.yml) ---
# only needed if you use that overlay; ignore these when you already run a
# reverse proxy. AUTH_DOMAIN must be a subdomain of CADENCE_DOMAIN so one
# session cookie covers both, e.g. cadence.example.com + auth.cadence.example.com
CADENCE_DOMAIN=
AUTH_DOMAIN=
# filled in by scripts/init-auth.sh; leave empty here.
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_JWT_SECRET=
# port Authelia is published on (loopback only) by docker-compose.authelia.yml
AUTHELIA_PORT=9091

# state lives in named volumes by default, which avoids ownership and SQLite
# locking trouble on Docker Desktop. on Linux you can point these at
# directories instead, to back them up with ordinary tools:
#   CADENCE_AUTHELIA_DATA=./data/authelia
#   CADENCE_CADDY_DATA=./data/caddy
#   CADENCE_CADDY_CONFIG=./data/caddy-config
CADENCE_AUTHELIA_DATA=
CADENCE_CADDY_DATA=
CADENCE_CADDY_CONFIG=
# image tag used by docker-compose.yml when pulling instead of building
CADENCE_VERSION=latest
