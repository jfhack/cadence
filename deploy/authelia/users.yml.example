---
# generated by scripts/init-auth.sh; this file is only an illustration.
#
# `password` is an argon2id hash, never a plaintext password. generate one
# with:
#   docker run --rm authelia/authelia:4 \
#     authelia crypto hash generate argon2 --password 'your-password'
#
# add family members by copying a block and giving them their own hash.
users:
  alice:
    disabled: false
    displayname: 'Alice'
    password: '$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'
    email: 'alice@example.com'
    groups:
      - 'users'
